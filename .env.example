# Evercrest Operations ERP — environment variables
# Copy to .env.local for local work. On Vercel, set them in Project → Settings → Environment Variables.
# Never commit real values. Values marked SECRET must never be exposed to the browser.

# --- Sign-in --------------------------------------------------------------
# supabase (default, the only mode for the live site) | dev (local work and UI tests only; refused on Vercel production)
AUTH_MODE=supabase

# --- Supabase project (Project Settings → API) ------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (or the legacy "anon" key). Safe to be public; grants nothing because every table is locked.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SECRET: the secret key (or the legacy "service_role" key). Used only on the server for invitations and file storage.
SUPABASE_SECRET_KEY=sb_secret_...

# --- Database (Project Settings → Database → Connection string) --------------
# SECRET. On Vercel use the transaction pooler (port 6543). For migrations and setup use the session pooler (port 5432).
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# SECRET. Session pooler (port 5432), used by production deployments to apply migrations before the build.
MIGRATION_DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Supabase's CA certificate (Database settings → SSL configuration → Download certificate), PEM text.
# With it, the connection is encrypted and the server's identity is verified. Newlines may be written as \n.
DATABASE_CA_CERT=
# Keep small on serverless hosting.
DATABASE_POOL_MAX=5

# --- Links in e-mails (invitations, password reset) ---------------------------------
SITE_URL=https://erp.evercrest.example

# --- First-run setup ---------------------------------------------------------------
# SECRET. A long random code (at least 24 characters). While no company exists, /en/welcome asks for it and
# creates the company and the first administrator. The page disappears once the company exists; then delete it.
SETUP_TOKEN=
# Only for the command-line alternative (scripts/setup-production.ts):
COMPANY_NAME=Evercrest
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_LOCALE=en
